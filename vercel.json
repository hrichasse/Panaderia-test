{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "cd pasteleria-mil-sabores && npm run build",
  "outputDirectory": "pasteleria-mil-sabores/dist",
  "installCommand": "cd pasteleria-mil-sabores && npm install",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
